---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, postUrl, formatDate, isoDate, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts(); // 新的在前
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

interface Props {
  post: Post;
  newer: Post | null;
  older: Post | null;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, summary, date, period, cover, coverAlt, draft } = post.data;
---

<Base title={title} description={summary} image={cover} current="devlog" type="article">
  <main class="page">
    <article>
      <header class="post-head">
        <a class="back" href="/devlog/">← 所有文章</a>
        <div class="meta">
          <time class="date" datetime={isoDate(date)}>{formatDate(date)}</time>
          {period && <span>{period}</span>}
          {draft && <span>草稿（不會發佈）</span>}
        </div>
        <h1>{title}</h1>
        <p class="lede">{summary}</p>
      </header>

      {
        cover && (
          <figure class="post-cover">
            <img src={cover} alt={coverAlt ?? title} width="1600" height="900" decoding="async" />
          </figure>
        )
      }

      <div class="prose">
        <Content />
      </div>
    </article>

    {
      (older || newer) && (
        <nav class="post-nav" aria-label="上一篇、下一篇">
          {older && (
            <a class="prev" href={postUrl(older)}>
              <span class="label">← 上一篇</span>
              <span class="title">{older.data.title}</span>
            </a>
          )}
          {newer && (
            <a class="next" href={postUrl(newer)}>
              <span class="label">下一篇 →</span>
              <span class="title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </main>
</Base>
